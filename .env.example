# --- Core ---
DATABASE_URL=postgresql+asyncpg://trackbridge:trackbridge@db:5432/trackbridge
# Comma-separated keys accepted in the X-API-Key header (warehouse scanner / admin API)
API_KEYS=change-me-long-random-key
# Public HTTPS URL of this service (used to register the Telegram webhook)
PUBLIC_BASE_URL=

# --- Telegram (optional; notifications are skipped when empty) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=change-me-webhook-secret
# Comma-separated chat IDs of KZ managers who receive every status change
TELEGRAM_MANAGER_CHAT_IDS=

# --- WhatsApp Cloud API (optional; skipped when empty) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Approved template with 3 body params: {{1}} tracking code, {{2}} status, {{3}} client name.
# Leave empty to send plain text (only delivered inside the 24h customer service window).
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=ru
